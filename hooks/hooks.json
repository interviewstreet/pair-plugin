{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/bootstrap.py\"",
            "timeout": 5,
            "statusMessage": "Preparing Pair CLI"
          }
        ]
      }
    ]
  }
}
